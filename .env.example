# ============================================================================
# .env.example – dokumentacja zmiennych środowiskowych.
# Skopiuj jako .env i uzupełnij wartości. Nie commituj .env do repozytorium.
# ============================================================================

# --- MySQL ---
MYSQL_DATABASE=wedding_gallery
MYSQL_USER=wedding
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PORT=3306

# --- Backend ---
# Profil Spring Boot: dev | prod (docker-compose domyślnie prod)
SPRING_PROFILES_ACTIVE=prod
# W compose backend jest dostępny wyłącznie przez Nginx; storage jest trwałym volume.
STORAGE_LOCAL_ROOT=/data/media
SESSION_COOKIE_SECURE=false

# Jednorazowy bootstrap pierwszego administratora. Po utworzeniu konta ustaw
# enabled=false i usun haslo ze srodowiska uruchomieniowego.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Puste oznacza same-origin only; zaufane originy rozdziel przecinkami.
CORS_ALLOWED_ORIGIN_PATTERNS=

# --- Frontend ---
FRONTEND_PORT=5173
# URL backendu używany przez Vite proxy w trybie dev
VITE_API_URL=http://localhost:8080

# --- Nginx ---
NGINX_PORT=80

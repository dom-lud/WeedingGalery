#!/bin/sh

set -eu

run_frontend_check() {
  echo "Running frontend format check..."

  (
    cd frontend
    if command -v cmd.exe >/dev/null 2>&1; then
      cmd.exe //d //s //c "npm.cmd run format:check"
    else
      npm run format:check
    fi
  )
}

run_backend_check() {
  echo "Running backend Spotless check..."

  (
    cd backend
    if command -v cmd.exe >/dev/null 2>&1; then
      cmd.exe //d //s //c "mvnw.cmd -B spotless:check"
    else
      ./mvnw -B spotless:check
    fi
  )
}

run_frontend_check
run_backend_check
